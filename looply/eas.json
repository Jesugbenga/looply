{
    "cli": {
      "version": ">= 5.9.1",
      "appVersionSource": "remote"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal",
        "env": {
          "NPM_CONFIG_CACHE": "/tmp/.npm"
        },
        "cache": {
          "disabled": false
        },
        "ios": {
          "image": "macos-sonoma-14.6-xcode-16.0",
          "buildConfiguration": "Debug",
          "simulator": true,
          "env": {
            "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
            "CLANG_CXX_LIBRARY": "libc++",
            "OTHER_CFLAGS": "-D_LIBCPP_ENABLE_CXX20_REMOVED_FEATURES -Wno-error=unused-command-line-argument -DGRPC_BAZEL_BUILD -Wno-unused-command-line-argument -Wno-error=unused-command-line-argument",
            "SWIFT_STRICT_CONCURRENCY": "minimal",
            "SWIFT_VERSION": "6.0",
            "SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE": "NO",
            "SWIFT_UPCOMING_FEATURE_FORWARD_TRAILING_CLOSURES": "NO",
            "SWIFT_UPCOMING_FEATURE_STRICT_CONCURRENCY": "NO",
            "GRPC_BAZEL_BUILD": "1",
            "GRPC_USE_BAZEL": "1"
          }
        }
      },
      "preview": {
        "distribution": "internal",
        "env": {
          "NPM_CONFIG_CACHE": "/tmp/.npm"
        },
        "ios": {
          "image": "macos-sonoma-14.6-xcode-16.0",
          "resourceClass": "m-medium",
          "env": {
            "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
            "CLANG_CXX_LIBRARY": "libc++",
            "OTHER_CFLAGS": "-D_LIBCPP_ENABLE_CXX20_REMOVED_FEATURES -Wno-error=unused-command-line-argument -DGRPC_BAZEL_BUILD -Wno-unused-command-line-argument -Wno-error=unused-command-line-argument",
            "SWIFT_STRICT_CONCURRENCY": "minimal",
            "SWIFT_VERSION": "6.0",
            "SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE": "NO",
            "SWIFT_UPCOMING_FEATURE_FORWARD_TRAILING_CLOSURES": "NO",
            "SWIFT_UPCOMING_FEATURE_STRICT_CONCURRENCY": "NO",
            "GRPC_BAZEL_BUILD": "1",
            "GRPC_USE_BAZEL": "1"
          }
        },
        "android": {
          "buildType": "apk"
        }
      },
      "production": {
        "env": {
          "NPM_CONFIG_CACHE": "/tmp/.npm"
        },
        "ios": {
          "image": "macos-sonoma-14.6-xcode-16.0",
          "resourceClass": "m-medium",
          "buildConfiguration": "Release",
          "env": {
            "CLANG_CXX_LANGUAGE_STANDARD": "c++17",
            "GCC_C_LANGUAGE_STANDARD": "c17",
            "CLANG_CXX_LIBRARY": "libc++",
            "OTHER_CFLAGS": "-D_LIBCPP_ENABLE_CXX20_REMOVED_FEATURES -Wno-error=unused-command-line-argument -DGRPC_BAZEL_BUILD -Wno-unused-command-line-argument -Wno-error=unused-command-line-argument",
            "SWIFT_STRICT_CONCURRENCY": "minimal",
            "SWIFT_VERSION": "6.0",
            "SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE": "NO",
            "SWIFT_UPCOMING_FEATURE_FORWARD_TRAILING_CLOSURES": "NO",
            "SWIFT_UPCOMING_FEATURE_STRICT_CONCURRENCY": "NO",
            "GRPC_BAZEL_BUILD": "1",
            "GRPC_USE_BAZEL": "1"
          }
        },
        "android": {
          "buildType": "app-bundle"
        }
      }
    },
    "submit": {
      "production": {
        "ios": {
          "appleId": "jesuomo69@gmail.com",
          "ascAppId": "6752886548",
          "appleTeamId": "25H6GX8A78"
        }
      }
    }
  }